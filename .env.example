# Strava API credentials.
# Create an application at https://www.strava.com/settings/api to get these.
# Set the "Authorization Callback Domain" of that app to: localhost
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
