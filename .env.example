# Strava API credentials.
# Create an application at https://www.strava.com/settings/api to get these.
# Set the "Authorization Callback Domain" of that app to: localhost
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Notes:
# - CLI (strava_export.py): both values above are required; tokens, cache and
#   reports are saved under data/users/<clientId>/ after the first browser login.
# - Web server (server.py): these are optional. If set, this account becomes the
#   default user. Other users just add their own credentials on the home page;
#   per-user secrets and tokens are stored under data/users/<clientId>/.
